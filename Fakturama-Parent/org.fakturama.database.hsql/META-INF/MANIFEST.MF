Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: hsql-database-connector
Bundle-SymbolicName: org.fakturama.database.hsql;singleton:=true
Bundle-Vendor: Fakturama.org
Bundle-Version: 2.2.0
Export-Package: org.fakturama.database.hsql
Bundle-Activator: org.fakturama.database.hsql.Activator
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: org.fakturama.database.hsql
Bundle-ActivationPolicy: lazy
Import-Package: org.osgi.framework;version="1.3.0",
 org.osgi.service.jdbc;version="1.1.0"
Require-Bundle: org.hsqldb.hsqldb;bundle-version="2.7.2";visibility:=reexport,
 slf4j.api;bundle-version="2.0.9"
