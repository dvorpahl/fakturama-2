Import-Package: com.opcoach.e4.preferences,
 com.sebulli.fakturama.misc,
 org.eclipse.jface.preference,
 org.osgi.service.jdbc,
 javax.sql
Automatic-Module-Name: com.sebulli.fakturama.hsqlconnector
Bundle-ClassPath: .
