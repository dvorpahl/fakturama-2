Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: HSQL DB-Connector
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-SymbolicName: com.sebulli.fakturama.hsqlconnector;singleton:=true
Bundle-Version: 2.1.3.qualifier
Bundle-Vendor: Fakturama.org
Service-Component: OSGI-INF/hsqlserveractivation.xml
