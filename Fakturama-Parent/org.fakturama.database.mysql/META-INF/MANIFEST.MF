Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: mysql-database-connector
Bundle-SymbolicName: org.fakturama.database.mysql;singleton:=true
Bundle-Vendor: Fakturama.org
Bundle-Version: 2.2.0.qualifier
Bundle-Activator: org.fakturama.database.mysql.Activator
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: org.fakturama.database.mysql
Bundle-ActivationPolicy: lazy
Import-Package: org.osgi.framework;version="1.3.0",
 org.osgi.service.jdbc;version="1.1.0"
Require-Bundle: com.mysql.cj;bundle-version="8.2.0";visibility:=reexport
