        <detail
            key="/instance/org.eclipse.jdt.ui/sp_cleanup.always_use_parentheses_in_expressions">
          <value>record</value>
        </detail>
        <detail
            key="/instance/org.eclipse.jdt.ui/sp_cleanup.always_use_this_for_non_static_field_access">
          <value>record</value>
