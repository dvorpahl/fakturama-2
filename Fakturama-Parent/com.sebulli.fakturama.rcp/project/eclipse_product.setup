<?xml version="1.0" encoding="UTF-8"?>
<setup:Product
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:git="http://www.eclipse.org/oomph/setup/git/1.0"
    xmlns:jdt="http://www.eclipse.org/oomph/setup/jdt/1.0"
    xmlns:pde="http://www.eclipse.org/oomph/setup/pde/1.0"
    xmlns:projects="http://www.eclipse.org/oomph/setup/projects/1.0"
    xmlns:setup="http://www.eclipse.org/oomph/setup/1.0"
    xmlns:setup.p2="http://www.eclipse.org/oomph/setup/p2/1.0"
    xsi:schemaLocation="http://www.eclipse.org/oomph/setup/git/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/Git.ecore http://www.eclipse.org/oomph/setup/jdt/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/JDT.ecore http://www.eclipse.org/oomph/setup/pde/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/PDE.ecore http://www.eclipse.org/oomph/setup/projects/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/Projects.ecore"
    name="eclipse.fakturama.product"
    label="Eclipse IDE Fakturama">
  <annotation
      source="http://www.eclipse.org/oomph/setup/BrandingInfo">
    <detail
        key="readmePath">
      <value>readme/readme_eclipse.html</value>
    </detail>
  </annotation>
  <setupTask
      xsi:type="setup:VariableTask"
      type="FOLDER"
      name="installation.location"
      defaultValue="${user.home}/fakturama/eclipse"
      label="Installation location">
    <annotation
        source="ImpliedVariable">
      <reference
          href="index:/org.eclipse.setup#//@productCatalogs[name='self']/'installation'"/>
      <reference
          href="http://www.eclipse.org/oomph/setup/1.0#//InstallationTask/location"/>
    </annotation>
    <choice
        value="${install.root/}${installation.id}"
        label="Installed in a uniquely-named folder within the root install folder"/>
    <choice
        value="${installation.location}"
        label="Installed in the specified absolute folder location"/>
    <description>The rule for the absolute folder location where the product is installed</description>
  </setupTask>
  <setupTask
      xsi:type="setup:VariableTask"
      type="JRE"
      name="jre.location"
      defaultValue="${user.home}/fakturama/(jrk/jdk-version)"
      label="JRE/JDK location">
    <description>The location of a JDK or JRE compatible with Java 17</description>
  </setupTask>
  <setupTask
      xsi:type="setup:VariableTask"
      type="FOLDER"
      name="workspace.location"
      defaultValue="${user.home}/fakturama/workspace"
      label="Workspace location">
    <annotation
        source="ImpliedVariable">
      <reference
          href="index:/org.eclipse.setup#//@projectCatalogs[name='org.eclipse']/'workspace'"/>
      <reference
          href="http://www.eclipse.org/oomph/setup/1.0#//WorkspaceTask/location"/>
    </annotation>
    <choice
        value="${installation.location/ws}"
        label="Located in a folder named 'ws' within the installation folder"/>
    <choice
        value="${workspace.container.root/}${workspace.id}"
        label="Located in a uniquely-named folder within the root workspace-container folder"/>
    <choice
        value="${workspace.location}"
        label="Located in the specified absolute folder location"/>
    <description>The rule for the absolute folder location where the workspace is located</description>
  </setupTask>
  <setupTask
      xsi:type="setup:VariableTask"
      type="FOLDER"
      name="git.clone.location"
      value="${workspace.location}"
      defaultValue="${workspace.location}"
      label="Workspace location">
    <description>The rule for the absolute folder location where the workspace is located</description>
  </setupTask>
  <setupTask
      xsi:type="setup:EclipseIniTask"
      option="-Doomph.redirection.fakturama.2.git"
      value="https://bitbucket.org/fakturamadev/fakturama-2/raw/develop/Fakturama-Parent/com.sebulli.fakturama.rcp/project/eclipse_product.setup ->${git.clone.fakturama2.location|uri}/Fakturama-Parent/com.sebulli.fakturama.rcp/project/eclipse_product.setup"
      vm="true">
    <description>Set an Oomph redirection system property to redirect the logical location of this setup to its physical location in the Git clone.</description>
  </setupTask>
  <setupTask
      xsi:type="setup:EclipseIniTask"
      id="org.fakturama.install.ini"
      option="-Xmx"
      value="4g"
      vm="true">
    <description>Set the heap space needed to work with the projects of ${scope.project.label}</description>
  </setupTask>
  <setupTask
      xsi:type="jdt:JRETask"
      version="JavaSE-21"
      location="${jre.location}">
    <description>Define the JRE needed to compile and run the Java projects of ${scope.project.label}</description>
  </setupTask>
  <setupTask
      xsi:type="git:GitCloneTask"
      id="git.clone.fakturama2"
      remoteURI="https://bitbucket.org/fakturamadev/fakturama-2.git"
      checkoutBranch="develop"
      recursive="true">
    <description>Git Clone</description>
  </setupTask>
  <setupTask
      xsi:type="projects:ProjectsImportTask"
      id="ImportAllProjects"
      force="true">
    <sourceLocator
        rootFolder="${git.clone.fakturama2.location}"
        locateNestedProjects="true"/>
  </setupTask>
  <setupTask
      xsi:type="pde:TargetPlatformTask"
      id="Fakturama.Target.platform.activate"
      name="org.fakturama.target"/>
  <setupTask
      xsi:type="pde:APIBaselineFromTargetTask"
      id="org.fakturama.target.activate"
      name="Fakturama API Baseline"
      targetName="org.fakturama.target">
    <description>An API baseline based on the target platform named 'Modular Target for Fakturama'</description>
  </setupTask>
  <setupTask
      xsi:type="setup.p2:P2Task"
      id="SpotBugs"
      label="SpotBugs">
    <requirement
        name="com.github.spotbugs.plugin.eclipse.feature.group"/>
    <repository
        url="https://spotbugs.github.io/eclipse/"/>
    <description>SpotBugs</description>
  </setupTask>
  <setupTask
      xsi:type="setup.p2:P2Task"
      id="EasyShell"
      label="EasyShell">
    <requirement
        name="de.anbos.eclipse.easyshell.feature.feature.group"/>
    <repository
        url="http://anb0s.github.io/EasyShell"/>
    <description>EasyShell</description>
  </setupTask>
  <setupTask
      xsi:type="setup.p2:P2Task"
      id="AsciiDoctor-Editor"
      label="AsciiDoctor Editor">
    <requirement
        name="de.jcup.asciidoctoreditor.feature.group"/>
    <repository
        url="https://de-jcup.github.io/update-site-eclipse-asciidoctor-editor/update-site/"/>
    <description>AsciiDoctor Editor</description>
  </setupTask>
  <setupTask
      xsi:type="setup.p2:P2Task"
      label="Oomph Update Site">
    <requirement
        name="org.eclipse.oomph.setup.feature.group"/>
    <repository
        url="${oomph.update.url}"/>
  </setupTask>
  <setupTask
      xsi:type="setup.p2:P2Task"
      id="MoreUnit"
      label="MoreUnit">
    <requirement
        name="org.moreunit.feature.group"/>
    <repository
        url="https://moreunit.github.io/eclipse-update-site/"/>
  </setupTask>
