<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.sebulli.fakturama</groupId>
		<artifactId>Fakturama-Parent</artifactId>
		<version>2.2.1.PREVIEW</version>
	</parent>
	<artifactId>com.sebulli.fakturama.site</artifactId>
	<packaging>eclipse-repository</packaging>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<formats>
						<win32>zip</win32>
						<linux>tar.gz</linux>
						<macosx>tar.gz</macosx>
					</formats>
					<products>
						<product>
							<id>Fakturama.ID</id>
							<rootFolders>
								<!-- for MacOSX, make sure you use a folder ending with .app , see 
									bug 463670 -->
								<macosx>Fakturama2.app</macosx>
							</rootFolders>
						</product>
					</products>
				</configuration>
				<executions>
					<execution>
						<id>materialize-products</id>
						<goals>
							<goal>materialize-products</goal>
						</goals>
					</execution>
					<execution>
						<id>archive-products</id>
						<goals>
							<goal>archive-products</goal>
						</goals>
						<!-- Moved from the default "package" phase (same as materialize-products) to run
						     strictly after weave-model-bundle below, which needs the materialized product
						     directories but must itself finish before the archives are built from them. -->
						<phase>pre-integration-test</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<!-- Runs after materialize-products (same "package" phase, declared later in this
						     file - Maven executes same-phase executions in POM order) and before
						     archive-products (explicitly moved to pre-integration-test above), so the
						     archived products ship com.sebulli.fakturama.model already statically woven.
						     See weave-model-bundle.sh's own comment for why this is needed at all: without
						     weaving, persistence.xml's lazy fetch mappings on self-referencing Document
						     fields (sourceDocument/invoiceReference) are silently ignored at runtime and
						     resolved eagerly for every row instead - confirmed to cause ~140 extra one-row
						     SELECTs opening the default document list on a real dataset. -->
						<id>weave-model-bundle</id>
						<phase>package</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>bash</executable>
							<arguments>
								<argument>${project.basedir}/weave-model-bundle.sh</argument>
								<argument>${project.build.directory}/products</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>