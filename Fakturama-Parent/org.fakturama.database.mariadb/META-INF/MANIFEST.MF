Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: mariadb-database-connector
Bundle-SymbolicName: org.fakturama.database.mariadb;singleton:=true
Bundle-Vendor: Fakturama.org
Bundle-Version: 2.2.0.qualifier
Bundle-Activator: org.fakturama.database.mariadb.Activator
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: org.fakturama.database.mysql
Bundle-ActivationPolicy: lazy
Import-Package: org.osgi.framework;version="1.3.0",
 org.osgi.service.jdbc;version="1.1.0"
Require-Bundle: mariadb-java-client;bundle-version="3.2.0";visibility:=reexport
