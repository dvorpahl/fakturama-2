<!--
Follow-up after a full audit of every DAO query against the live index set
(2026-09-01): FKT_DOCUMENT.BILLINGTYPE and FKT_DOCUMENT.TRANSACTIONID are real,
independent columns (not to be confused with DTYPE, the JPA joined-inheritance
discriminator, which is already covered by IDX_DOC_LIST_DATE/IDX_DOC_LIST_NAME/
IDX_DOC_OPEN_INVOICES) and were completely unindexed despite being used as
equality filters by several live DocumentsDAO methods:
  - BILLINGTYPE: findAccountedDocuments, findByDocIdAndDocDate,
    findSelectedDeliveries/findAllDeliveriesWithoutInvoice,
    findPaidOrUnpaidDocumentsInRange, getReference,
    findExistingDocumentByTransactionIdAndBillingType
  - TRANSACTIONID: findByTransactionId, getReference,
    findExistingDocumentByTransactionIdAndBillingType, mergeTwoTransactions
-->

    <changeSet author="dvorpahl" id="20260901-101" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="FKT_DOCUMENT" indexName="IDX_DOC_TRANSACTION_BILLINGTYPE"/></not>
        </preConditions>
        <createIndex indexName="IDX_DOC_TRANSACTION_BILLINGTYPE" tableName="FKT_DOCUMENT">
            <column name="TRANSACTIONID"/>
            <column name="BILLINGTYPE"/>
            <column name="DELETED"/>
        </createIndex>
    </changeSet>

    <changeSet author="dvorpahl" id="20260901-102" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
