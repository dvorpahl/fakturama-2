<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" 
xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" 
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet author="boarschti" id="20241014-001">
         <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM FKT_USERPROPERTY WHERE NAME = 'OPENOFFICE_ODT_PDF' AND T_VALUE LIKE '%ODT%'
            </sqlCheck>
        </preConditions>
        <insert tableName="FKT_USERPROPERTY">
            <column name="NAME" value="OPENOFFICE_SAVE_ODT"/>
            <column name="T_VALUE" value="true"/>
            <column name="DATEADDED" valueComputed="CURRENT_TIMESTAMP" />
            <column name="T_USER" value="System"/>
            <column name="VALIDFROM" valueComputed="CURRENT_TIMESTAMP" />
        </insert>
    </changeSet>
    
    <changeSet author="boarschti" id="20241014-002">
        <delete tableName="FKT_USERPROPERTY">
            <where>NAME = 'OPENOFFICE_ODT_PDF'</where>
        </delete>
    </changeSet>
	
	<changeSet author="rheydenr" id="20241229-001"
		objectQuotingStrategy="QUOTE_ALL_OBJECTS">
		<addColumn tableName="FKT_DOCUMENTRECEIVER">
			<column name="NAME_ADDON" type="VARCHAR(255)" />
		</addColumn>
	</changeSet>
    
	<changeSet author="boarschti" id="20250302-001"
		objectQuotingStrategy="QUOTE_ALL_OBJECTS">
		<update tableName="FKT_PAYMENT">
            <column name="CODE" value="ZZZ" />
            <where>CODE is null</where>
		</update>
	</changeSet>
    
    <changeSet author="boarschti" id="20250703-001"
        objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <addColumn tableName="FKT_VAT">
            <column name="CODE" type="VARCHAR(5)" />
        </addColumn>
    </changeSet>
    
	<changeSet author="boarschti" id="20250703-002"
		objectQuotingStrategy="QUOTE_ALL_OBJECTS">
		<update tableName="FKT_VAT">
            <column name="CODE" value="S" />
            <where>CODE is null</where>
		</update>
	</changeSet>
</databaseChangeLog>