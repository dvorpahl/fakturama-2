<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

<!--
Follow-up to db.changelog-2.2.1.xml after a full audit of every DAO query
against the live index set (2026-09-01): FKT_DOCUMENT.BILLINGTYPE and
FKT_DOCUMENT.TRANSACTIONID are real, independent columns (not to be confused
with DTYPE, the JPA joined-inheritance discriminator, which is already
covered by IDX_DOC_LIST_DATE/IDX_DOC_LIST_NAME/IDX_DOC_OPEN_INVOICES) and were
completely unindexed despite being used as equality filters by several live
DocumentsDAO methods:
  - BILLINGTYPE: findAccountedDocuments, findByDocIdAndDocDate,
    findSelectedDeliveries/findAllDeliveriesWithoutInvoice,
    findPaidOrUnpaidDocumentsInRange, getReference,
    findExistingDocumentByTransactionIdAndBillingType
  - TRANSACTIONID: findByTransactionId, getReference,
    findExistingDocumentByTransactionIdAndBillingType, mergeTwoTransactions
-->

    <changeSet author="dvorpahl" id="20260901-101" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="FKT_DOCUMENT" indexName="IDX_DOC_TRANSACTION_BILLINGTYPE"/></not>
        </preConditions>
        <createIndex indexName="IDX_DOC_TRANSACTION_BILLINGTYPE" tableName="FKT_DOCUMENT">
            <column name="TRANSACTIONID"/>
            <column name="BILLINGTYPE"/>
            <column name="DELETED"/>
        </createIndex>
    </changeSet>

    <changeSet author="dvorpahl" id="20260901-102" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="FKT_DOCUMENT" indexName="IDX_DOC_BILLINGTYPE_DELETED"/></not>
        </preConditions>
        <createIndex indexName="IDX_DOC_BILLINGTYPE_DELETED" tableName="FKT_DOCUMENT">
            <column name="DELETED"/>
            <column name="BILLINGTYPE"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
