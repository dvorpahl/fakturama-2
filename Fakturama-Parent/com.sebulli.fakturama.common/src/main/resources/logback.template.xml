<?xml version="1.0" encoding="UTF-8"?>
<!-- This is the configuration for the Logback logger.
     It serves as a template file which is initially copied to the 
     workspace. The path for the workspace is replaced by the application
     while initializing the logger.
-->
<configuration debug="false">
    <property name="LOG_PATH" value="${user.home}/.fakturama2/Logs" />

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/Error.log</file>
        <immediateFlush>true</immediateFlush>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>${LOG_PATH}/Error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- keep 30 days' worth of history -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyyMMdd HH:mm:ss.SSS} | %-5level | %marker | %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- DEBUG (not ERROR): ILogger goes through the OSGi LogService -> LogbackAdapter, which logs
         by the calling bundle's symbolic name (e.g. "com.sebulli.fakturama.rcp"), not by Java
         package - so a narrower per-package logger below this one has no effect. This is what
         makes the FKT.* JS bridge (BrowserEditor/FktBridge, see its log.debug() calls) traceable:
         a call that silently returns false to the web page (untrusted origin, no matching
         product/document, ...) still leaves a line here instead of no trace at all. -->
    <!-- additivity="false": full DEBUG detail still goes to the log file for support/
         troubleshooting, but no longer floods the console on every run - see
         "achte auch auf das ausschalten des default debuggings auf der console" (final build). -->
    <logger name="com.sebulli.fakturama" level="DEBUG" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="org.fakturama" level="ERROR"/>
    <logger name="org.mariadb.jdbc" level="ERROR"/>
    <logger name="org.mariadb.jdbc.impl" level="ERROR"/>
    <logger name="liquibase" level="ERROR"/>
    <logger name="org.apache.hc.client5.http" level="ERROR" />

    <root level="ERROR">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>